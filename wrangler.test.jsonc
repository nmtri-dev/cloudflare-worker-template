{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-worker-template-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": ""
  },
  "services": [
    {
      "binding": "ACCESS_MGMT",
      "service": "cardy-ai-access-management-local",
      // The access-management worker exposes its `authorize` RPC here. Named
      // entrypoint must match the binding declared in wrangler.jsonc.
      "entrypoint": "AccessManagementEntrypoint"
    },
    {
      // Permissive rate limiter stub for integration tests — resolves to the
      // `cloudflare-worker-template-rate-limit-mock` worker defined in
      // vitest.integration.config.mts. The real `ratelimit` binding is not
      // available in the vitest pool; rate-limit behavior is covered by unit
      // tests in test/middlewares/rateLimit.spec.ts.
      "binding": "RATE_LIMITER",
      "service": "cloudflare-worker-template-rate-limit-mock"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-worker-template-db-test",
      "migrations_dir": "migrations"
    }
  ]
}
