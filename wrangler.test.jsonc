{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-worker-template-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": ""
  },
  "services": [
    {
      "binding": "ACCESS_MGMT",
      "service": "cardy-ai-access-management-local",
      // The access-management worker exposes its `authorize` RPC here. Named
      // entrypoint must match the binding declared in wrangler.jsonc.
      "entrypoint": "AccessManagementEntrypoint"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-worker-template-db-test",
      "migrations_dir": "migrations"
    }
  ]
}
