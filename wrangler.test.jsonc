{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-worker-template-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-29",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.key"], "fallthrough": false }],
  "vars": {
    "ALLOWED_ORIGINS": ""
  },
  "services": [
    {
      "binding": "ACCESS_MGMT",
      "service": "cardy-ai-access-management-local"
    }
  ],
  "d1_databases": [
    {
      "binding": "CREDIT_DB",
      "database_name": "cardy-ai-credit-db-test",
      "database_id": "test-db"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "credit-reset-queue",
        "max_retries": 3
      }
    ],
    "producers": [
      {
        "binding": "CREDIT_RESET_QUEUE",
        "queue": "credit-reset-queue"
      }
    ]
  }
}
